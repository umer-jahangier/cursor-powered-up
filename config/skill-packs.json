{
  "$comment": "Skill packs installed by scripts/lib/powerup.mjs for every selected agent. Per item, per agent, the FIRST matching route wins: (1) claudePlugin when the agent is claude-code, (2) native installer when it maps that agent (the method the upstream README recommends), (3) `npx skills add` as the universal fallback (also used when a native installer fails). `cli` = a companion CLI installed once if its bin is missing. Never use upstream `setup` commands that write into the current directory. Skills already present in an agent's skills dir are skipped unless --force. Verified 2026-09-27.",
  "packs": {
    "ui-design": {
      "default": true,
      "description": "Design taste + UI/UX quality (Impeccable is primary; see src/rules/10-design-precedence.md)",
      "items": [
        {
          "id": "frontend-design",
          "description": "Anthropic official frontend-design (fallback baseline)",
          "url": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/frontend-design",
          "claudePlugin": {
            "marketplace": "anthropics/claude-plugins-official",
            "plugin": "frontend-design@claude-plugins-official"
          },
          "skills": {
            "source": "anthropics/skills",
            "names": [
              "frontend-design"
            ]
          }
        },
        {
          "id": "impeccable",
          "description": "Impeccable by Paul Bakaus — primary design authority (/impeccable audit|polish|...)",
          "url": "https://github.com/pbakaus/impeccable",
          "claudePlugin": {
            "marketplace": "pbakaus/impeccable",
            "plugin": "impeccable@impeccable"
          },
          "native": {
            "mode": "batch",
            "cmd": [
              "npx",
              "-y",
              "impeccable",
              "install",
              "--global",
              "-y",
              "--providers={providers}"
            ],
            "providers": {
              "cursor": "cursor",
              "codex": "codex",
              "gemini-cli": "gemini",
              "github-copilot": "github",
              "opencode": "opencode"
            }
          },
          "skills": {
            "source": "pbakaus/impeccable",
            "names": [
              "impeccable"
            ]
          }
        },
        {
          "id": "taste-skill",
          "description": "Taste Skill (Leonxlnx) — variance / motion / density dials",
          "url": "https://github.com/Leonxlnx/taste-skill",
          "skills": {
            "source": "Leonxlnx/taste-skill",
            "names": [
              "design-taste-frontend"
            ]
          }
        },
        {
          "id": "ui-ux-pro-max",
          "description": "UI UX Pro Max — styles, palettes, font pairings, design-system generator",
          "url": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill",
          "claudePlugin": {
            "marketplace": "nextlevelbuilder/ui-ux-pro-max-skill",
            "plugin": "ui-ux-pro-max@ui-ux-pro-max-skill"
          },
          "native": {
            "mode": "per-agent",
            "cmd": [
              "npx",
              "-y",
              "-p",
              "ui-ux-pro-max-cli",
              "uipro",
              "init",
              "--global",
              "--ai",
              "{provider}"
            ],
            "providers": {
              "cursor": "cursor",
              "codex": "codex",
              "gemini-cli": "gemini",
              "github-copilot": "copilot"
            },
            "$comment": "uipro --global writes Windsurf/OpenCode/Antigravity/Kiro skills to folders those agents don't read, so they use npx skills instead (verified 2026-09-27)."
          },
          "skills": {
            "source": "nextlevelbuilder/ui-ux-pro-max-skill",
            "names": [
              "ui-ux-pro-max"
            ]
          }
        },
        {
          "id": "ibelick-ui-skills",
          "description": "ibelick ui-skills — fast deslop, motion perf and a11y fixers",
          "url": "https://github.com/ibelick/ui-skills",
